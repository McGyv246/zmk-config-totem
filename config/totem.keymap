//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17 18>;
            timeout-ms = <50>;
        };

        combo_greater {
            bindings = <&kp GREATER_THAN>;
            key-positions = <10 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_question {
            bindings = <&kp QUESTION>;
            key-positions = <21 16>;
            layers = <2>;
            timeout-ms = <50>;
        };

        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <22 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_percent {
            bindings = <&kp PERCENT>;
            key-positions = <23 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <24 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_backslash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <25 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <4 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_apostrophe {
            bindings = <&kp APOS>;
            key-positions = <14 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_win {
            bindings = <&sk LEFT_WIN>;
            key-positions = <12 13 11>;
            timeout-ms = <50>;
        };

        combo_underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <19 16>;
            timeout-ms = <50>;
            layers = <2>;
        };

        combo_alt {
            bindings = <&sk LEFT_ALT>;
            key-positions = <22 23 24>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <27 28 29>;
        };
    };

    macros {
        /* ---------- lowercase ---------- */

        acc_a_lc: acc_a_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_e_gr_lc: acc_e_gr_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_e_ac_lc: acc_e_ac_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_i_lc: acc_i_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_o_lc: acc_o_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_u_lc: acc_u_lc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N9>,
                <&macro_release>,
                <&kp LALT>;
        };

        /* ---------- uppercase ----------
         * Each one first releases Shift: with NumLock on, a held Shift turns
         * the numpad keys into navigation keys and would break the Alt code.
         */

        acc_a_uc: acc_a_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_e_gr_uc: acc_e_gr_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_e_ac_uc: acc_e_ac_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_i_uc: acc_i_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N4>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_o_uc: acc_o_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        acc_u_uc: acc_u_uc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings =
                <&macro_release>,
                <&kp LSHFT &kp RSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    behaviors {
        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_semi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Shift-aware versions: plain press = lowercase, Shift+press = uppercase. */

        ac_a: ac_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_a_lc>, <&acc_a_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_e_gr: ac_e_gr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_e_gr_lc>, <&acc_e_gr_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_e_ac: ac_e_ac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_e_ac_lc>, <&acc_e_ac_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_i: ac_i {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_i_lc>, <&acc_i_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_o: ac_o {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_o_lc>, <&acc_o_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ac_u: ac_u {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&acc_u_lc>, <&acc_u_uc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            label = "BASE";
            bindings = <
                &kp Q  &kp W  &kp E      &kp R        &kp T    &kp Y  &kp U      &kp I          &kp O      &kp P
                &kp A  &kp S  &kp D      &kp F        &kp G    &kp H  &kp J      &kp K          &kp L      &kp APOSTROPHE
&sk LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V        &kp B    &kp N  &kp M      &comma_semi    &dot_semi  &kp FSLH        &sk RIGHT_SHIFT
                              &sk LCTRL  &key_repeat  &to 2    &to 1  &kp SPACE  &kp BACKSPACE
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            label = "NAVI";
            bindings = <
        &msc SCRL_UP    &bt BT_CLR      &mkp LCLK     &mkp MCLK       &mkp RCLK          &kp HOME      &kp PG_DN   &kp PG_UP        &kp END              &kp INS
        &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &kp LEFT      &kp DOWN    &kp UP           &kp RIGHT            &kp CAPSLOCK
&trans  &none           &none           &none         &none           &none              &kp LC(LEFT)  &kp C_MENU  &kp PRINTSCREEN  &kp LC(RIGHT_ARROW)  &kp DELETE    &trans
                                        &trans        &mo 3           &to 0              &to 2         &trans      &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        num_sim_layer {
            label = "NUM_SYM";
            bindings = <
        &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_BRACKET  &kp TILDE            &kp KP_DIVIDE  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_ASTERISK
        &kp LESS_THAN     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL          &kp DOUBLE_QUOTES    &kp KP_PLUS    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS
&trans  &kp EXCLAMATION   &kp AT_SIGN           &kp DOLLAR             &kp CARET          &kp PIPE             &kp KP_N0      &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp COMMA        &kp KP_DOT
                                                &trans                 &mo 3              &to 0                &to 1          &trans     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        adjust_layer {
            label = "ADJ";
            bindings = <
        &kp C_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_BRI_DEC  &kp C_BRI_UP    &bt BT_CLR  &kp F7  &kp F8  &kp F9  &kp F12
        &kp C_PREV  &kp C_NEXT    &ac_a            &ac_u          &ac_i           &bt BT_NXT  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &none       &none         &ac_o            &ac_e_ac       &ac_e_gr        &bt BT_PRV  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                  &trans           &none          &none           &none       &trans  &trans
            >;
        };
    };
};
